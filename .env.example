# Salin file ini menjadi ".env" lalu isi nilainya. Semua nama harus diawali VITE_

# Alamat Worker Cloudflare Anda (berakhiran .workers.dev), tanpa garis miring di akhir
VITE_WORKER_URL=https://nama-worker-anda.akun-anda.workers.dev

# Opsional: harus sama dengan variabel EVENT_KEY di Worker. Kosongkan jika tidak dipakai.
VITE_EVENT_KEY=

# Dari Supabase: Project Settings > API
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=isi-dengan-anon-atau-publishable-key

# Opsional: true = mode demo (tanpa AI, hanya efek warna di browser). Berguna untuk menguji tampilan tanpa memakai kuota.
VITE_DEMO_MODE=false
